# ── Banco e filas ─────────────────────────────────────────
DATABASE_URL=postgresql://socialmanager:socialmanager@localhost:5432/socialmanager
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# ── Acesso ao painel (OBRIGATÓRIO: sem isso o login fica bloqueado) ──
# Senha do administrador e segredo de assinatura da sessão (mín. 16 caracteres):
#   openssl rand -base64 32
ADMIN_PASSWORD=
AUTH_SECRET=

# ── Criptografia das chaves de API guardadas no banco (OBRIGATÓRIO p/ cadastrar provedores) ──
# 32 bytes em base64:  openssl rand -base64 32
# Em produção use um secret manager/KMS. Perder esta chave = perder as chaves cadastradas.
ENCRYPTION_KEY=

# ── Armazenamento das saídas geradas (imagens/áudios). Padrão: ./.data/storage ──
STORAGE_DIR=

# ── Integrações sociais ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube (login com Google). Veja README → "Conectar o YouTube".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínio público canônico (usado no redirecionamento do OAuth). Na Vercel é detectado sozinho.
APP_URL=
# E-mail exibido na Política de Privacidade (opcional).
CONTACT_EMAIL=

# Obs.: a chave do gateway de IA NÃO vai aqui. Cadastre pela tela "Central de IA";
# ela é criptografada com ENCRYPTION_KEY e guardada no banco.
