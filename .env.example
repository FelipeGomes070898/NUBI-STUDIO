# ── Banco e filas ─────────────────────────────────────────
DATABASE_URL=postgresql://socialmanager:socialmanager@localhost:5432/socialmanager
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# ── Acesso ao painel (OBRIGATÓRIO: sem isso o login fica bloqueado) ──
# Senha do administrador e segredo de assinatura da sessão (mín. 16 caracteres):
#   openssl rand -base64 32
ADMIN_PASSWORD=
AUTH_SECRET=

# ── Criptografia das chaves de API guardadas no banco (OBRIGATÓRIO p/ cadastrar provedores) ──
# 32 bytes em base64:  openssl rand -base64 32
# Em produção use um secret manager/KMS. Perder esta chave = perder as chaves cadastradas.
ENCRYPTION_KEY=

# ── Publicação de vídeos ──
# Vercel Blob (upload do vídeo direto do navegador). Criado ao conectar um Blob store ao projeto.
BLOB_READ_WRITE_TOKEN=
# Segredo do agendador (>=16 caracteres): openssl rand -base64 32. Sem ele /api/cron/publish fica desligado.
CRON_SECRET=
# Opcionais: tamanho máximo do vídeo (MB, padrão 512), intervalo mínimo entre posts da mesma conta (min, padrão 60)
# e fuso padrão para mensagens quando o navegador não informa (padrão America/Sao_Paulo).
MAX_VIDEO_MB=
PUBLISH_MIN_GAP_MINUTES=
APP_TIMEZONE=

# ── Armazenamento das saídas geradas (imagens/áudios). Padrão: ./.data/storage ──
STORAGE_DIR=

# ── Integrações sociais ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Facebook (login com Meta). Veja README → "Conectar o Facebook".
META_APP_ID=
META_APP_SECRET=
# Opcional: versão da Graph API (padrão v23.0) e permissões extras, ex.: pages_show_list,pages_manage_posts,pages_read_engagement,business_management
META_GRAPH_VERSION=
META_SCOPES=
# TikTok (login com TikTok). Veja README → "Conectar o TikTok".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Opcional: escopos (padrão user.info.basic,video.upload,video.publish)
TIKTOK_SCOPES=
# YouTube (login com Google). Veja README → "Conectar o YouTube".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (APP_URL acima também define o domínio do redirecionamento do OAuth; na Vercel é detectado sozinho.)
# E-mail exibido na Política de Privacidade (opcional).
CONTACT_EMAIL=

# Obs.: a chave do gateway de IA NÃO vai aqui. Cadastre pela tela "Central de IA";
# ela é criptografada com ENCRYPTION_KEY e guardada no banco.
